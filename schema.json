{
  "workflow_id": "EuQL3RwAz5ULPxjP",
  "name": "survey-cleaner-mvp",
  "description": "n8n workflow with built-in form upload for survey file cleaning",
  "form_endpoint": "n8n form with webhookId 17f8e709-76d0-49c6-b4af-6d5f7a2201b8",
  "active": true,
  "flow": {
    "trigger": {
      "type": "formTrigger",
      "form_title": "Upload",
      "fields": [
        {
          "label": "Codebook",
          "type": "file",
          "required": true,
          "accepted_types": ".txt, .pdf, .html, .csv, .xlsx"
        },
        {
          "label": "Données",
          "type": "file",
          "required": false
        }
      ]
    },
    "processing": [
      {
        "step": "format_detection",
        "description": "Detect codebook file format based on extension",
        "branches": ["txt", "pdf", "csv", "xlsx"]
      },
      {
        "step": "txt_processing",
        "description": "Process TXT codebooks - convert to markdown",
        "status": "implemented"
      },
      {
        "step": "pdf_processing", 
        "description": "Process PDF codebooks",
        "status": "placeholder"
      },
      {
        "step": "csv_processing",
        "description": "Process CSV codebooks",
        "status": "placeholder"
      },
      {
        "step": "xlsx_processing",
        "description": "Process XLSX codebooks", 
        "status": "placeholder"
      }
    ]
  },
  "conventions": {
    "demographic_prefix": "demo_",
    "opinion_prefix": "op_",
    "missing_values": "NA",
    "scale_standardization": "0-1 for opinion variables"
  },
  "supported_formats": {
    "survey_files": ["csv", "sav", "xlsx"],
    "codebook_files": ["txt", "pdf", "csv", "xlsx", "html"]
  },
  "usage": {
    "access": "Direct n8n form interface - no external HTML page needed",
    "form_url": "Generated by n8n formTrigger node",
    "response_format": "Markdown codebook output for downstream processing"
  }
}