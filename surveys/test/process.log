### Step 4: Load Data and Extract Column Names

Creating temporary script to extract column names:

```bash
cat > surveys/test/_init_get_columns.py << 'EOF'
import pandas as pd
import sys
from pathlib import Path

survey_dir = Path("surveys/test")
raw_dir = survey_dir / "raw"

# Find data file
data_files = list(raw_dir.glob("*.csv")) + list(raw_dir.glob("*.sav")) + list(raw_dir.glob("*.xlsx")) + list(raw_dir.glob("*.dta"))
if not data_files:
    print("ERROR: No data file found")
    sys.exit(1)

data_file = data_files[0]
print(f"Loading: {data_file.name}")

# Load based on extension
try:
    if data_file.suffix == ".csv":
        df = pd.read_csv(data_file)
    elif data_file.suffix == ".sav":
        import pyreadstat
        df, meta = pyreadstat.read_sav(data_file)
    elif data_file.suffix in [".xlsx", ".xls"]:
        df = pd.read_excel(data_file)
    elif data_file.suffix == ".dta":
        df = pd.read_stata(data_file)
    else:
        print(f"ERROR: Unsupported format {data_file.suffix}")
        sys.exit(1)
except Exception as e:
    print(f"ERROR loading file: {e}")
    sys.exit(1)

# Output results
print(f"\nTotal observations: {len(df)}")
print(f"Total variables: {len(df.columns)}")
print("\nColumn names:")
for col in df.columns:
    print(col)
EOF
```

```bash
source venv/bin/activate && python surveys/test/_init_get_columns.py
```

Let me capture the output and proceed with creating the tracking files. Based on the column names extracted, I'll now create the tracking files.

### Step 5: Create variables_todo.md

```bash
python << 'EOF'
import subprocess
import sys

# Run the script and capture output
result = subprocess.run(
    ["bash", "-c", "source venv/bin/activate && python surveys/test/_init_get_columns.py"],
    capture_output=True,
    text=True
)

if result.returncode != 0:
    print("ERROR: Could not extract column names")
    print(result.stderr)
    sys.exit(1)

lines = result.stdout.strip().split('\n')

# Parse output
data_file = ""
n_obs = 0
n_vars = 0
columns = []
in_columns = False

for line in lines:
    if line.startswith("Loading:"):
        data_file = line.split(": ")[1]
    elif line.startswith("Total observations:"):
        n_obs = int(line.split(": ")[1])
    elif line.startswith("Total variables:"):
        n_vars = int(line.split(": ")[1])
    elif line == "Column names:":
        in_columns = True
    elif in_columns and line.strip():
        columns.append(line.strip())

# Create variables_todo.md
with open("surveys/test/variables_todo.md", "w") as f:
    f.write(f"# Variables Processing Todo - Test Survey\n")
    f.write(f"**Total variables**: {n_vars}\n")
    f.write(f"**Completed**: 0\n")
    f.write(f"**Remaining**: {n_vars}\n\n")
    f.write(f"## Completed\n\n")
    f.write(f"## In Progress\n\n")
    f.write(f"## Questions (need human input)\n\n")
    f.write(f"## Pending\n")
    for col in columns:
        f.write(f"- [ ] {col}\n")

print(f"✓ Created variables_todo.md with {len(columns)} variables")

# Create pending_vars.txt
with open("surveys/test/pending_vars.txt", "w") as f:
    for col in columns:
        f.write(f"{col}\n")

print(f"✓ Created pending_vars.txt with {len(columns)} variables")
print(f"\nData file: {data_file}")
print(f"Observations: {n_obs}")
print(f"Variables: {n_vars}")
EOF
```

