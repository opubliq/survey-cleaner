        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"variables\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\"type\": \"string\"},\n          \"label\": {\"type\": \"string\"},\n          \"type\": {\"type\": \"string\"},\n          \"values\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"code\": {\"type\": \"string\"},\n                \"label\": {\"type\": \"string\"}\n              },\n              \"required\": [\"code\", \"label\"]\n            }\n          }\n        },\n        \"required\": [\"name\", \"label\", \"type\", \"values\"]\n      }\n    }\n  },\n  \"required\": [\"variables\"]\n}\n"
